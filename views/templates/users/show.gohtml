{{define "content"}}
<section>
    <h1>Detalhe do Usuário</h1>
    {{with .User}}
    <dl>
        <dt>ID</dt><dd>{{.ID}}</dd>
        <dt>Nome</dt><dd>{{.Name}}</dd>
        <dt>E-mail</dt><dd>{{.Email}}</dd>
        <dt>Criado em</dt><dd>{{.CreatedAt.Format "02/01/2006"}}</dd>
    </dl>
    {{end}}
    <a href="/users">Voltar à lista</a>
</section>
{{end}}
