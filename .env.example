# Copie para .env e preencha. Em produção use variáveis de ambiente no servidor.

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=sua_senha
DB_NAME=rose_gym_db
DB_SSLMODE=disable

# Abacate Pay
ABACATE_PAY_API_KEY=sua_chave_aqui

# Opcional
# PORT=8080
# ENV=development
# JWT_SECRET=change-me-in-production
# JWT_EXPIRATION_HOURS=72
