# Copie para .env e preencha. Em produção use variáveis de ambiente no servidor.

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=sua_senha
DB_NAME=rose_gym_db
DB_SSLMODE=disable

# Abacate Pay
ABACATE_PAY_API_KEY=sua_chave_aqui
# Secret do webhook: defina um valor e use o MESMO na URL ao criar o webhook no dashboard:
# https://SUA_API.com/webhooks/abacatepay?webhookSecret=este_mesmo_valor
# Sem isso, o banco não será atualizado quando o pagamento for confirmado.
ABACATE_PAY_WEBHOOK_SECRET=seu_secret_webhook_aqui
# Métodos de pagamento na cobrança: PIX (padrão) ou PIX,CARD (só use CARD se sua loja tiver habilitado)
# ABACATE_PAY_METHODS=PIX

# Opcional
# PORT=8080
# ENV=development
# JWT_SECRET=change-me-in-production
# JWT_EXPIRATION_HOURS=72
