# Copie para .env e preencha. Em produção use variáveis de ambiente no servidor.

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=sua_senha
DB_NAME=rose_gym_db
DB_SSLMODE=disable

# Abacate Pay
# Chave do dashboard (API v2). O registro cria cliente em POST /v2/customers/create; chave antiga só v1 gerava "API key version mismatch".
# Chave de teste/sandbox: checkouts vêm com devMode=true e aparecem no painel na área de sandbox/ambiente de testes, não só na lista de produção.
ABACATE_PAY_API_KEY=sua_chave_aqui
# Secret do webhook: defina um valor e use o MESMO na URL ao criar o webhook no dashboard Abacate Pay.
# O path /webhooks/abacatepay é obrigatório (a raiz / não existe e retorna 404):
#   https://SUA_API.com/webhooks/abacatepay?webhookSecret=este_mesmo_valor
#   https://xxxx.ngrok-free.dev/webhooks/abacatepay?webhookSecret=este_mesmo_valor
# Sem isso, o banco não será atualizado quando o pagamento for confirmado.
ABACATE_PAY_WEBHOOK_SECRET=seu_secret_webhook_aqui
# Métodos de pagamento na cobrança: PIX (padrão) ou PIX,CARD (só use CARD se sua loja tiver habilitado)
# ABACATE_PAY_METHODS=PIX
# API v2 (assinaturas recorrentes): base URL e métodos do checkout (doc: padrão CARD)
# ABACATE_PAY_V2_BASE_URL=https://api.abacatepay.com/v2
# ABACATE_PAY_SUBSCRIPTION_METHODS=CARD

# Opcional
# PORT=8080
# ENV=development
# JWT_SECRET=change-me-in-production
# JWT_EXPIRATION_HOURS=72
